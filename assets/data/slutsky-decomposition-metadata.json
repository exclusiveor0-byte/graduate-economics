{
  "title": "Slutsky decomposition: price changes and compensation rules",
  "model": "Two-good Cobb-Douglas consumer",
  "utility": "u(x1,x2) = x1^alpha x2^(1-alpha)",
  "fixedPrice": { "p2": 1 },
  "initialPrice": { "p1": 1, "p2": 1 },
  "defaultParameters": { "alpha": 0.5, "income": 100, "newPrice1": 1.5 },
  "compensationRules": {
    "slutsky": "mS = p1_new*x1_initial + p2*x2_initial",
    "hicks": "mH = e(p_new, u_initial)"
  },
  "chartAxes": {
    "x1Range": [0, 150],
    "x2Range": [0, 150],
    "rescaleWithInputs": false
  },
  "staticFigure": "Side-by-side comparison of Slutsky and Hicks compensation",
  "implementation": {
    "externalDependencies": false,
    "networkRequests": false
  }
}
